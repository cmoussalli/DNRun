root = true

# Windows PowerShell 5.1 decodes BOM-less files as the system ANSI codepage, not UTF-8.
# A stray non-ASCII character (e.g. an em dash) then decodes to bytes the parser reads as
# smart quotes, breaking the script. The BOM forces correct UTF-8 decoding.
[*.ps1]
charset = utf-8-bom
end_of_line = crlf
indent_style = space
indent_size = 4

# install.ps1 is fetched as a string and run through `iex` / ScriptBlock::Create, and a leading
# BOM makes that parse fail. It is kept strictly ASCII instead, so ANSI decoding is harmless.
[install.ps1]
charset = utf-8
